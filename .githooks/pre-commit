#!/usr/bin/env python
import subprocess
import sys

checks = [
    [sys.executable, "HW1/scripts/verify_outputs.py"],
    [sys.executable, "HW2/scripts/verify_hw2_outputs.py"],
]
for check in checks:
    result = subprocess.call(check)
    if result:
        raise SystemExit(result)
raise SystemExit(0)

